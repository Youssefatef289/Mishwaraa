# ===== متغيرات الذكاء الاصطناعي (AI Studio / Gemini) =====
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# ===== Supabase — قاعدة بيانات مشوار =====
# انسخ القيم من مشروعك في Supabase Dashboard → Project Settings → API.
# الطبقة تتكيف مع VITE_ أو NEXT_PUBLIC_ وتعمل تلقائياً بالبيانات التجريبية إن تُركت فارغة.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# (اختياري — لمتوافقي النسخة القديمة من التطبيق)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM="Mishwar <bookings@example.com>"
PAYMOB_ENABLED=false
TWILIO_ENABLED=false
