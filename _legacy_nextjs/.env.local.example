# ضع قيمك الحقيقية هنا (من Supabase Dashboard → Project Settings → API).
# انسخ هذا الملف إلى .env.local عشان يشتغل مع `npm run dev` من نفس الفولدر.

# مطلوب لحزمة REST API + الموقع كله:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# للتحقق من البيانات والإيميلات من السيرفر (admin / emailFor):
SUPABASE_SERVICE_ROLE_KEY=

# مطلوب لحساب الأسعار (Distance Matrix API):
GOOGLE_MAPS_API_KEY=

# اختياري — إشعارات الإيميل:
RESEND_API_KEY=
NOTIFICATION_FROM=